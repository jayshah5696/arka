    "ComplexityEloFilterConfig": {
      "additionalProperties": false,
      "description": "Slice 5 \u2014 Simula \u00a72.3 batch-Elo complexity scoring.\n\nAnnotates each ConversationRecord with a comparable `complexity_elo` and\ndoes NOT drop. Filter or select stages downstream can consume the score.",
