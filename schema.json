          "title": "Batch Size",
          "type": "integer"
        },
        "samples_per_record": {
          "default": 4,
          "title": "Samples Per Record",
          "type": "integer"
        },
        "k_factor": {
          "default": 32.0,
          "title": "K Factor",
          "type": "number"
        },
        "llm_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageLLMOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ComplexityEloFilterConfig",
      "type": "object"
    },
