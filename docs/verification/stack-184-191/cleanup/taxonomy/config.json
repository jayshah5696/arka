{
  "version": "1",
  "llm": {
    "provider": "openai",
    "model": "local-fixture",
    "api_key": "local-fixture",
    "base_url": "http://127.0.0.1:42545/v1",
    "timeout_seconds": 10,
    "max_retries": 1,
    "supports_json_schema": true
  },
  "executor": {
    "mode": "threadpool",
    "max_workers": 1
  },
  "pipeline": [
    {
      "type": "taxonomy_generator",
      "taxonomy_path": "/tmp/arka-verification-20261010-cleanup/taxonomy.json",
      "target_count": 8,
      "generation_multiplier": 1
    },
    {
      "type": "artifact_filter"
    },
    {
      "type": "repetition"
    },
    {
      "type": "identity_claim"
    },
    {
      "type": "exact"
    },
    {
      "type": "select",
      "target_count": 2,
      "coverage": [
        {
          "factor": "topic",
          "path": [
            "science"
          ]
        },
        {
          "factor": "topic",
          "path": [
            "arts"
          ]
        }
      ],
      "weights": {}
    }
  ],
  "output": {
    "format": "chatml",
    "path": "dataset.jsonl"
  }
}
